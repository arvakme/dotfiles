{
 "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
 "palette": {
  "os": "#908caa",
  "closer": "p:os",
  "orange": "#f6c177",
  "pink": "#eb6f92",
  "blue": "#c4a7e7",
  "green": "#3e8fb0"
 },
 "blocks": [
  {
   "alignment": "left",
   "segments": [
    {
     "foreground": "p:os",
     "style": "plain",
     "template": "{{.Icon}} ",
     "type": "os"
    },
    {
     "foreground": "p:blue",
     "foreground_templates": [
      "{{ if .SSHSession }}p:green{{ end }}"
     ],
     "style": "plain",
     "template": "{{ if .SSHSession }}💻 {{ .HostName }} · {{ end }}{{ .UserName }} ",
     "type": "session"
    },
    {
     "foreground": "p:orange",
     "options": {
      "folder_icon": "....",
      "home_icon": "~",
      "style": "agnoster_short"
     },
     "style": "plain",
     "template": "{{ .Path }} ",
     "type": "path"
    },
    {
     "foreground": "p:pink",
     "options": {
      "branch_icon": " ",
      "cherry_pick_icon": " ",
      "commit_icon": " ",
      "fetch_status": false,
      "fetch_upstream_icon": false,
      "merge_icon": " ",
      "no_commits_icon": " ",
      "rebase_icon": " ",
      "revert_icon": " ",
      "tag_icon": " "
     },
     "template": "{{ .HEAD }} ",
     "style": "plain",
     "type": "git"
    },
    {
     "style": "plain",
     "foreground": "p:closer",
     "template": "",
     "type": "text"
    }
   ],
   "type": "prompt"
  }
 ],
 "final_space": true,
 "version": 4
}
