# Butler dark — generated by ~/.config/theme/butler/generate.py from palette.json — edit the palette, not this file
[delta]
    line-numbers = true
    side-by-side = false
    navigate = true
    syntax-theme = Nord
    features = decorations
    minus-style = syntax "#3f2c43"
    minus-emph-style = syntax "#eb6f92"
    plus-style = syntax "#273047"
    plus-emph-style = syntax "#3e8fb0"
    line-numbers-minus-style = "#eb6f92"
    line-numbers-plus-style = "#3e8fb0"
    line-numbers-zero-style = "#9490b3"
    line-numbers-left-style = "#56526e"
    line-numbers-right-style = "#56526e"
[delta "interactive"]
    keep-plus-minus-markers = true
[delta "decorations"]
    commit-decoration-style = "#9ccfd8" ol
    commit-style = raw
    file-style = omit
    hunk-header-decoration-style = "#9ccfd8" box
    hunk-header-file-style = "#9ccfd8"
    hunk-header-line-number-style = "#3e8fb0"
    hunk-header-style = file line-number syntax
