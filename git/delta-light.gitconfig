# Butler light — generated by ~/.config/theme/butler/generate.py from palette.json — edit the palette, not this file
[delta]
    line-numbers = true
    side-by-side = false
    navigate = true
    syntax-theme = GitHub
    features = decorations
    minus-style = syntax "#ece1e6"
    minus-emph-style = syntax "#b4637a"
    plus-style = syntax "#d8e1e8"
    plus-emph-style = syntax "#286983"
    line-numbers-minus-style = "#b4637a"
    line-numbers-plus-style = "#286983"
    line-numbers-zero-style = "#9a99ad"
    line-numbers-left-style = "#cdcddd"
    line-numbers-right-style = "#cdcddd"
[delta "interactive"]
    keep-plus-minus-markers = true
[delta "decorations"]
    commit-decoration-style = "#56949f" ol
    commit-style = raw
    file-style = omit
    hunk-header-decoration-style = "#56949f" box
    hunk-header-file-style = "#56949f"
    hunk-header-line-number-style = "#286983"
    hunk-header-style = file line-number syntax
