# Config generated by Ghostty Config

command = /bin/zsh --login
custom-shader = ~/.config/ghostty/shaders/cursor.frag

quick-terminal-screen = mouse
term=xterm-256color
# follows the system appearance by itself; herdr, Pi and Claude Code follow the terminal in turn
theme = light:butler-light,dark:butler-dark
# Liquid-glass: translucent background with heavy blur, text cells stay opaque
# 不要设 minimum-contrast：对比度不够的文字会被直接换成纯黑/纯白，浅色主题下语法高亮会整片消失
background-opacity = 0.82
background-opacity-cells = false
background-blur = 40
# English and code in Paper Mono (OFL, github.com/paper-design/paper-mono); Chinese falls back to Maple Mono NF CN (Light: Regular plus font-thicken looks bold next to Paper Mono),
# anything both lack (Nerd Font icons) to Comic Shanns. Keep ss02 (duospace) off: it breaks the cell grid.
font-family = Paper Mono
font-family = Maple Mono NF CN Light
font-family = ComicShannsMono Nerd Font
font-size = 17.5
font-thicken = true
macos-icon = glass
macos-icon-frame = chrome
macos-titlebar-style = transparent
# keybind = shift+enter=text:\x1b\r
keybind = global:super+ctrl+alt+shift+backslash=toggle_quick_terminal

# my-agent-workstation include omitted on purpose.
# That fragment remaps Cmd+T/N/W to Herdr and overrides titlebar/font/shift+enter.
